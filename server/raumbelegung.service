[Unit]
Description=Raumbelegung BWS – Belegungsdienst
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/raumbelegung.env
ExecStart=/usr/bin/node /opt/raumbelegung/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
